{
  "manifest_version": 3,
  "name": "VocabMaster AI",
  "version": "1.1.3",
  "description": "Dịch và phân tích từ vựng tiếng Anh bằng AI. Lưu từ mới, luyện tập qua minigame Flashcard, Quiz, Typing.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/*"],
      "js": ["content/gdocs-preload.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "sidePanel",
    "contextMenus",
    "identity",
    "cookies",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "settings/settings.html",
  "web_accessible_resources": [
    {
      "resources": [
        "lib/xlsx.min.js",
        "lib/pdf.min.js",
        "lib/pdf.worker.min.js",
        "lib/pdf_viewer.min.css",
        "pdf/reader.html",
        "pdf/reader.css",
        "pdf/reader.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
